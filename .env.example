# Copy to apps/mobile/.env.local and fill in. NEVER commit real values.
# NOTE: every EXPO_PUBLIC_* value is embedded in the app bundle — treat as public.
# Firebase config itself comes from apps/mobile/google-services.json (git-ignored).

# Optional fallback market-data providers (free tiers) — see docs/HLD.md §6
EXPO_PUBLIC_TWELVE_DATA_API_KEY=YOUR_TWELVE_DATA_KEY
EXPO_PUBLIC_FINNHUB_API_KEY=YOUR_FINNHUB_KEY

# Firebase App Check debug token for emulator/dev builds (register in Firebase console)
EXPO_PUBLIC_APP_CHECK_DEBUG_TOKEN=YOUR_DEBUG_TOKEN
